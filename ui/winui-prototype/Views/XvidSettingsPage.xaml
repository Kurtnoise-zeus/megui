<Page
    x:Class="WinUIPrototype.Views.XvidSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:WinUIPrototype.Views"
    mc:Ignorable="d">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="xvid Configuration" FontSize="20" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
            <Button Content="Save" Click="Save_Click"/>
            <Button Content="Load" Click="Load_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
            <StackPanel Spacing="12">
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Rate Control" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <TextBlock Text="Reaction Delay Factor" Width="180" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Width="80" Text="{x:Bind ViewModel.ReactionDelayFactor, Mode=TwoWay}"/>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.Turbo, Mode=TwoWay}" Header="Turbo"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Quantizers" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <TextBlock Text="Min P Quant" Width="180" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Width="80" Text="{x:Bind ViewModel.MinPQuant, Mode=TwoWay}" />
                            <TextBlock Text="Max P Quant" Width="120" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Width="80" Text="{x:Bind ViewModel.MaxPQuant, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>

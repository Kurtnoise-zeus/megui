# NOTE: Requires **VS2019 16.7** or later

# 'Usage' Rules from '9.0' release with 'Default' analysis mode
# Description: 'Usage' Rules with enabled-by-default state from '9.0' release with 'Default' analysis mode. Rules that are first released in a version later than '9.0' are disabled.

is_global = true

global_level = -99


# CA2266: File-based program entry point should start with '#!'
dotnet_diagnostic.CA2266.severity = none

# CA2267: Quote whitespace in file-based program directive values
dotnet_diagnostic.CA2267.severity = none
